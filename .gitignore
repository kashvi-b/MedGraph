__pycache__/
*.py[cod]
.venv/
venv/
.env
.env.*
!.env.example
data/corpus/*
!data/corpus/.gitkeep
.pytest_cache/
*.egg-info/
.DS_Store
data/ingest_checkpoint.jsonl
# Generated by scripts/ingest.py — regenerable, and 3MB of float text does not
# belong in git. Use --out/--load to move it between machines.
data/vectors.jsonl
data/*.jsonl
# The README renders from these, and CI byte-checks the result, so the artifacts
# the published numbers come from must be committed. Anything else under
# results/ is scratch.
eval/results/*.json
!eval/results/retrieval.json
!eval/results/repeated.json
!eval/results/.gitkeep
