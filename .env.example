# ---------------------------------------------------------------------------
# LLM providers. Both are free tiers; neither requires a credit card.
#   Groq:   https://console.groq.com   -> API Keys
#   Gemini: https://aistudio.google.com -> Get API key
# ---------------------------------------------------------------------------
GROQ_API_KEY=
GOOGLE_API_KEY=

# Model ids live here, never in node code — free tiers deprecate models without
# notice, so a provider swap must be an env change.
#
# classify/extract MUST stay on these two Groq models: langchain-groq only sends
# strict=True for them, and silently drops it for anything else — which turns
# constrained decoding into best-effort JSON with no warning.
GROQ_MODEL_CLASSIFY=openai/gpt-oss-20b
GROQ_MODEL_EXTRACT=openai/gpt-oss-120b

# The two token-heavy nodes sit on Gemini so they don't consume Groq's
# 200,000 tokens/day/model budget.
GEMINI_MODEL_SYNTHESIZE=gemini-flash-lite-latest
GEMINI_MODEL_VERIFY=gemini-flash-lite-latest

# Groq free tier is 30 req/min per model. 0.4 req/s = 24 RPM, leaving headroom.
GROQ_REQUESTS_PER_SECOND=0.4

# ---------------------------------------------------------------------------
# Embeddings: local, no key, no quota. Dimension must match scripts/init.sql.
# ---------------------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# ---------------------------------------------------------------------------
# Database. Neon free plan (https://neon.tech) ships pgvector and needs no card.
# Use the -pooler host: free projects scale to zero after ~5 minutes idle.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.REGION.aws.neon.tech/medgraph?sslmode=require

RETRIEVAL_K=6
SIMILARITY_FLOOR=0.35
